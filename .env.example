# Copy to `.env` to override the defaults used by docker-compose.yml.
#   cp .env.example .env
# `.env` is git-ignored and excluded from Docker build contexts.

# --- PostgreSQL ---------------------------------------------------------
DB_USER=appuser
DB_PASSWORD=change-me-locally
DB_NAME=appdb

# --- Published ports (host side) ----------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=4000

# --- Frontend -> backend ------------------------------------------------
# API base URL baked into the React bundle at build time. "/api" = same origin
# (nginx proxies it to the backend). Use e.g. http://localhost:4000/api to make
# the browser call the backend directly instead.
VITE_API_BASE_URL=/api
